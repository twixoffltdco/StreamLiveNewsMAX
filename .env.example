# --- StreamLive в Max: переменные окружения ---

# Секрет для защиты /api/cron/generate-digest (любая длинная случайная строка)
CRON_SECRET=change-me-long-random-string

# Путь к SQLite-файлу. По умолчанию ./data/streamlive.db
# Vercel (Serverless Persistence): DATABASE_PATH=/mnt/data/streamlive.db
# Tatnet / VPS: оставьте по умолчанию или укажите /var/lib/streamlive/streamlive.db
DATABASE_PATH=

# Абсолютный URL сайта (для SEO canonical / OG / JSON-LD)
NEXT_PUBLIC_SITE_URL=https://streamlive-max.ru
