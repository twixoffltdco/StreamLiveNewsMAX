# --- StreamLive Daily: переменные окружения ---

# Абсолютный URL сайта (обязательно для sitemap, OG-тегов и пингов поисковикам)
NEXT_PUBLIC_SITE_URL=https://streamlive.app

# Площадки «StreamLive в Max» — ссылки кнопок подписки (Telegram / MAX / ВКонтакте)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/streamliveru
NEXT_PUBLIC_MAX_URL=https://max.ru/channel_StreamLive
NEXT_PUBLIC_VK_URL=https://vk.com/streamliveru

# Секрет для защиты /api/cron/update-news (Vercel подставляет CRON_SECRET автоматически)
CRON_SECRET=change-me-long-random-string

# Токен Яндекс.Webmaster для мгновенного переобхода sitemap после каждого cron-выпуска
YANDEX_WEBMASTER_TOKEN=

# Хук рерайта фактов через LLM (опционально; без ключа работает эвристический суммаризатор)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GIGACHAT_API_KEY=

# «Движ» — активные рубрики сводки через запятую.
# Когда тема СВО будет исчерпана, поменяйте порядок/состав — код трогать не нужно:
#   ACTIVE_MOVES=economy,tech,crypto,incidents
ACTIVE_MOVES=geopolitics,tech,crypto,incidents
