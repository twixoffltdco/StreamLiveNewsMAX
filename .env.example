# --- StreamLive Daily: переменные окружения ---

# Абсолютный URL сайта (обязательно для sitemap и OG-тегов).
# Регистрация в Яндекс.Вебмастере / Google Search Console НЕ требуется:
# роботы сами находят sitemap.xml через строку "Sitemap:" в robots.txt.
NEXT_PUBLIC_SITE_URL=https://streamlive.app

# Площадки «StreamLive в Max» — ссылки кнопок подписки (Telegram / MAX / ВКонтакте)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/streamliveru
NEXT_PUBLIC_MAX_URL=https://max.ru/channel_StreamLive
NEXT_PUBLIC_VK_URL=https://vk.com/streamliveru

# Секрет для защиты /api/cron/update-news (Vercel подставляет CRON_SECRET автоматически)
CRON_SECRET=change-me-long-random-string

# Хук рерайта фактов через LLM (опционально; без ключа работает эвристический суммаризатор)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GIGACHAT_API_KEY=

# «Движ» — рубрики сводки. Состав ФИКСИРОВАН владельцем и НИКОГДА не меняется
# автоматически: если переменная не задана, берётся жёсткий список из lib/config.ts
# (геополитика/СВО → технологии → крипта → ЧП). Менять состав — только вручную:
# раскомментируйте строку и уберите лишнее/добавьте нужное, либо отредактируйте
# DEFAULT_MOVES в lib/config.ts. Доступные id: geopolitics, tech, crypto,
# incidents, economy, sport.
# ACTIVE_MOVES=geopolitics,tech,crypto,incidents
