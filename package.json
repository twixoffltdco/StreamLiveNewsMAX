{
  "name": "streamlive-daily",
  "version": "1.0.0",
  "private": true,
  "description": "StreamLive Daily — автоматизированный новостной дайджест на Next.js 14 (App Router) с RSS-парсингом, cron-публикацией и SEO-оптимизацией под Яндекс и Google.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-digest.js --quiet || true; next build && next-sitemap",
    "start": "next start",
    "lint": "next lint",
    "cron": "node scripts/cron-daemon.js",
    "generate": "node scripts/generate-digest.js",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "next": "^14.2.35",
    "next-sitemap": "^4.2.3",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.31",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
